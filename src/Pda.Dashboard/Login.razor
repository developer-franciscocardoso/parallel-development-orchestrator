<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" /><meta name="viewport"
        content="width=device-width, initial-scale=1" />
    <title>Sign in · PDA</title>
    <link rel="stylesheet" href="/dashboard.css" />
</head>
<body class="login"><main>
    <div class="brand"><b>P</b> Parallel Development</div>
    <h1>Dashboard access</h1>
    <form method="post" action="/login" autocomplete="off">
        <label for="token">Dashboard token</label>
        <input type="password" id="token" name="token"
            autocomplete="current-password" required maxlength="512" />
        <p>Use the value of <code>PDA_DASHBOARD_TOKEN</code> configured
            for this running dashboard.</p>
        <button type="submit">Sign in</button>
    </form>
</main></body></html>
